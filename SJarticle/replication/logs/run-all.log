. do "00-setup.do"

. version 19

. clear all

. set more off

. set linesize 80

. 
. global cells N200_iid N200_drift N500_iid N500_drift

. global methods srs blocks minimization msb mmsb

. global nsims 1000

. global seed 20260611

. 
. local source : environment GRACEDR_SOURCE

. if "`source'" == "" {
.     local source "https://raw.githubusercontent.com/BiostatDoc/graceDR/main/st
> ata"
. }

. quietly net install gracedr, from("`source'") replace

. 
. local home "`c(pwd)'"

. foreach folder in data results figures studies {
  2.     capture mkdir `folder'
  3. }

. quietly cd data

. quietly net get gracedr, from("`source'") replace

. quietly cd "`home'"

. 
. quietly findfile gracedr.ado

. local plus = lower(subinstr("`c(sysdir_plus)'", char(92), "/", .))

. local installed = strpos(lower("`r(fn)'"), "`plus'") == 1

. if `installed' == 0 {
.     display as error "gracedr.ado was found outside the PLUS folder: `r(fn)'"
.     display as error "Remove that copy so that the installed package is the on
> e that runs."
.     exit 459
. }

. 
. python:
----------------------------------------------- python (type end to exit) ------
>>> import subprocess
>>> import sys
>>> 
>>> try:
...     import pyzipper
... except ImportError:
...     subprocess.check_call([sys.executable, "-m", "pip", "install", "pyzipper
> "])
...     import pyzipper
>>> end
--------------------------------------------------------------------------------

. 
. display "Stata " c(stata_version) ", " c(os) ", " c(machine_type)
Stata 19.5, Windows, PC (64-bit x86-64)

. display "The gracedr package is installed and its example files are in data/"
The gracedr package is installed and its example files are in data/

. 
end of do-file

. do "helpers.do"

. version 19

. 
. capture program drop remove_folder

. program define remove_folder
  1.     args folder
  2.     mata: st_local("found", strofreal(direxists(st_local("folder"))))
  3.     if `found' == 1 {
  4.         local files : dir "`folder'" files "*"
  5.         foreach file of local files {
  6.             quietly erase "`folder'/`file'"
  7.         }
  8.         quietly rmdir "`folder'"
  9.     }
 10. end

. 
. capture program drop show_table

. program define show_table
  1.     syntax varlist, TITLE(string)
  2.     display
  3.     display as text "`title'"
  4.     list `varlist', noobs separator(0) abbreviate(30)
  5. end

. 
. capture program drop use_study_participants

. program define use_study_participants
  1.     args study
  2.     capture confirm file "`study'/participants.dta"
  3.     if _rc == 0 {
  4.         use "`study'/participants.dta", clear
  5.     }
  6.     else {
  7.         encuse using "`study'/participants", clear
  8.     }
  9. end

. 
end of do-file

. do "01-simulate.do"

. version 19

. clear

. 
. local design "arms(A B) categorical(sex: male female | race: white black other
> )"

. local design "`design' continuous(age)"

. local iid "generator(iid) probs(sex: 0.48 0.52 | race: 0.62 0.23 0.15)"

. local iid "`iid' meansd(age: 60 10)"

. local drift "generator(drift) probs(sex: 0.20 0.80 | race: 0.77 0.08 0.15)"

. local drift "`drift' meansd(age: 48 8)"

. local drift "`drift' driftto(sex: 0.80 0.20 | race: 0.37 0.48 0.15 | age: 72 8
> )"

. 
. foreach size of numlist 200 500 {
  2.     foreach scenario in iid drift {
  3.         local cell "N`size'_`scenario'"
  4.         display as text "Running `cell'"
  5.         quietly gracedr simulate, ///
>             n(`size') ///
>             `design' ///
>             ``scenario'' ///
>             methods(${methods}) ///
>             nsims(${nsims}) ///
>             seed(${seed}) ///
>             saving("results/sim_`cell'.dta") ///
>             summary("results/summary_`cell'.dta")
  6.         display as text "Finished `cell': " r(nsims) " simulations of " r(m
> ethods)
  7.     }
  8. }
Running N200_iid
Finished N200_iid: 1000 simulations of srs blocks minimization msb mmsb
Running N200_drift
Finished N200_drift: 1000 simulations of srs blocks minimization msb mmsb
Running N500_iid
