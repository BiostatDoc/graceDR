. do "07-figure.do"

. version 19

. clear

. 
. use "results/stats_all.dta", clear

. local symbols "Oh Th S X O"

. local plots ""

. local position = 0

. foreach method in srs blocks minimization msb mmsb {
  2.     local position = `position' + 1
  3.     local symbol : word `position' of `symbols'
  4.     local series `"(scatter meansmd_end meanguess if method == "`method'","'
  5.     local series `"`series' msymbol(`symbol') mcolor(black) mlabel(method_label)"'
  6.     local series `"`series' mlabsize(vsmall) mlabcolor(black))"'
  7.     local plots `"`plots' `series'"'
  8. }

. twoway `plots', ///
>     by(setting, cols(2) legend(off) note("")) ///
>     xtitle("Correct-guess probability (%)") ///
