end of do-file

. do "02-summarize.do"

. version 19

. clear

. 
. capture program drop cell_stats

. program define cell_stats
  1.     args cell position
  2.     use "results/summary_`cell'.dta", clear
  3.     generate str12 key = ""
  4.     replace key = "smd_end" if point == "end" & metric == "smd_max"
  5.     replace key = "smd_runin" if point == "run-in" & metric == "smd_max"
  6.     replace key = "guess" if point == "all" & metric == "correct_guess"
  7.     replace key = "forced" if point == "all" & metric == "pct_deterministic
> "
  8.     replace key = "run" if point == "all" & metric == "longest_forced_run"
  9.     replace key = "dev_end" if point == "end" & metric == "size_dev_A"
 10.     keep if !missing(key)
 11.     keep method key mean sd q95 max
 12.     reshape wide mean sd q95 max, i(method) j(key) string
 13.     foreach key in smd_end guess {
 14.         generate se`key' = sd`key' / sqrt(${nsims})
 15.     }
 16. 
.     tempfile exact
 17.     preserve
 18.     use "results/sim_`cell'.dta", clear
 19.     keep if metric == "size_dev_A" & inlist(point, "run-in", "end")
 20.     generate byte exact = value == 0
 21.     collapse (mean) exact, by(method point)
 22.     replace exact = 100 * exact
 23.     replace point = subinstr(point, "-", "", .)
 24.     reshape wide exact, i(method) j(point) string
 25.     quietly save `"`exact'"'
 26.     restore
 27.     merge 1:1 method using `"`exact'"', assert(match) nogenerate
 28. 
.     generate str16 cell = "`cell'"
 29.     generate byte cellno = `position'
 30.     quietly save "results/stats_`cell'.dta", replace
 31. end

. 
. capture program drop cell_paired

. program define cell_paired
  1.     args cell
  2.     use "results/sim_`cell'.dta", clear
  3.     keep if (point == "end" & metric == "smd_max") | ///
>         (point == "all" & metric == "correct_guess")
  4.     generate str5 key = cond(metric == "smd_max", "smd", "guess")
  5.     keep sim method key value
  6.     reshape wide value, i(sim key) j(method) string
  7. 
.     tempname handle
  8.     tempfile paired
  9.     postfile `handle' str16 cell str12 method str5 key double(mean lower up
> per) ///
>         using `"`paired'"'
 10.     foreach method in srs blocks minimization msb {
 11.         foreach key in smd guess {
 12.             quietly generate double difference = value`method' - valuemmsb 
> if key == "`key'"
 13.             quietly summarize difference
 14.             local estimate = r(mean)
 15.             local error = r(sd) / sqrt(r(N))
 16.             post `handle' ("`cell'") ("`method'") ("`key'") (`estimate') //
> /
>                 (`estimate' - 1.96 * `error') (`estimate' + 1.96 * `error')
 17.             drop difference
 18.         }
 19.     }
 20.     postclose `handle'
 21.     use `"`paired'"', clear
 22.     quietly save "results/paired_`cell'.dta", replace
 23. end

. 
. local position = 0

. foreach cell of global cells {
  2.     local position = `position' + 1
  3.     cell_stats `cell' `position'
  4.     cell_paired `cell'
  5. }
