. do "05-encrypted-demo.do"

. version 19

. clear

. set linesize 80

. 
. python:
----------------------------------------------- python (type end to exit) ------
>>> import os
>>> import secrets
>>> 
>>> previous = {name: value for name, value in os.environ.items() if name == "GR
> ACEDR_PASSPHRASE"}
>>> os.environ["GRACEDR_PASSPHRASE"] = secrets.token_hex(16)
>>> end
--------------------------------------------------------------------------------

. 
. local study "studies/encrypted"

. remove_folder "`study'"

. 
. gracedr setup, ///
>     study("`study'") ///
>     n(40) ///
>     arms(A B) ///
>     categorical(sex: male female | race: white black other) ///
>     continuous(age) ///
>     codes("data/example_codes.csv") ///
>     seed(20260611) ///
>     encrypt
gracedr: 200 treatment codes are valid.
  arm A: 100 codes
  arm B: 100 codes
(file studies/encrypted/design.zip not found)
(file studies/encrypted/codes.zip not found)
(file studies/encrypted/participants.zip not found)
(file studies/encrypted/state.zip not found)
(file studies/encrypted/audit.zip not found)
gracedr: study created in studies/encrypted
  40 participants planned, run-in 10, seed 20260611

. 
. use "data/example_participants.dta", clear

. local total = _N

. forvalues row = 1/`total' {
  2.     local id = id[`row']
  3.     local sex = sex[`row']
  4.     local race = race[`row']
  5.     local age = age[`row']
  6.     quietly gracedr randomize, study("`study'") id(`id') sex(`sex') race(`r
> ace') age(`age')
  7. }

. 
. local last_id "`r(id)'"

. local last_arm "`r(arm)'"

. local new_arm = cond("`last_arm'" == "A", "B", "A")

. gracedr override, ///
>     study("`study'") ///
>     id(`last_id') ///
>     arm(`new_arm') ///
>     reason("Wrong race entered in the example.")
Participant P040 changed from arm A to arm B
Code 11394 voided, new code 71284

. 
. local files : dir "`study'" files "*"

. display as text `"Files in the encrypted study: `files'"'
Files in the encrypted study: "audit.bak.zip" "audit.zip" "codes.bak.zip" "codes
> .zip" "design.zip" "participants.bak.zip" "participants.zip" "state.bak.zip" "
> state.zip"

. gracedr status, study("`study'")
Study status: 40 participants randomized
Group sizes
Arm                        n     pct   Next target  Final target
A                         19    47.5            20            20
B                         21    52.5            20            20
Balance by arm
  arm1 = A
  arm2 = B

  +-----------------------------------------------------------------+
  | variable    level          arm1         arm2   nmissing     smd |
  |-----------------------------------------------------------------|
  |      sex     male    13 (68.4%)   14 (66.7%)          0   0.037 |
  |      sex   female     6 (31.6%)    7 (33.3%)          0   0.037 |
  |     race    white    10 (52.6%)   14 (66.7%)          0   0.289 |
  |     race    black     4 (21.1%)    3 (14.3%)          0   0.289 |
  |     race    other     5 (26.3%)    4 (19.0%)          0   0.289 |
  |      age            59.4 (13.0)   60.5 (9.0)          0   0.101 |
  +-----------------------------------------------------------------+

. 
. use_study_participants "studies/example"

. drop time

. tempfile plain

. quietly save `"`plain'"'

. use_study_participants "`study'"

. drop time

. local rows = _N

. cf _all using `"`plain'"'

. display as text "The encrypted and the plain study agree on `rows' participant
> s."
The encrypted and the plain study agree on 40 participants.

. 
